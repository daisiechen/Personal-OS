# 复制到 /home/ethan/.config/ethan/ethan.env，chmod 600。真实值不要提交到仓库。
TELEGRAM_BOT_TOKEN=
ETHAN_PAIRING_CODE=
# Mia 在自己电脑上运行 `claude setup-token` 生成的长期令牌，让服务器用她的订阅
CLAUDE_CODE_OAUTH_TOKEN=
# 可选：OpenRouter 兜底，需 Mia 在聊天里发 /openrouter on 才会启用
OPENROUTER_API_KEY=
ETHAN_OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
# 可选：小伴 做不了的事交给 Mia 的 Grok Bot（webhook 在 Grok 的 Routines 里）
GROK_WEBHOOK_URL=
GROK_WEBHOOK_SECRET=
# 密钥放在哪个请求头，默认 Authorization: Bearer <密钥>
GROK_WEBHOOK_SECRET_HEADER=
# 可选：苹果日历（CalDAV），App 专用密码在 account.apple.com 生成
ICLOUD_USERNAME=
ICLOUD_APP_PASSWORD=
# Grok 往接收口 ethan.example.com 回报用的密钥，setup_secrets 自动生成
INBOX_TOKEN_GROK=
# Claude 云端会话经接收口找 Grok 用的密钥，setup_secrets 自动生成，她抄进云端环境设置的 ETHAN_CLOUD_TOKEN
INBOX_TOKEN_CLOUD=
# DemoApp 的 worker 推举报提醒用的密钥，setup_secrets 自动生成，她抄进 DemoApp 部署配置的 ETHAN_MODERATION_TOKEN
INBOX_TOKEN_FANCY=

# 主力模型换成兼容 OpenAI 接口的（比如 DeepSeek），三项都填就不用 Claude 订阅；不填就用 Claude Code 订阅
ETHAN_LLM_BASE_URL=
ETHAN_LLM_API_KEY=
ETHAN_LLM_MODEL=
# 时区（IANA 名字，比如 Asia/Shanghai），不填默认 Europe/London
ETHAN_TZ=
# 天气用的城市坐标“纬度,经度”，不填默认伦敦市中心
ETHAN_WEATHER_LATLON=
