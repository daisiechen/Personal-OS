[Unit]
Description=小伴 v2 工作台 Earth Online（只监听本机，经 Cloudflare Tunnel 对外为 os.example.com）
After=network-online.target
Wants=network-online.target

[Service]
User=ethan
Group=ethan
WorkingDirectory=/home/ethan/Personal-OS
EnvironmentFile=/home/ethan/.config/ethan/ethan.env
Environment=PATH=/home/ethan/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/python3 -m ethan.workbench.server --data /home/ethan/data --host 127.0.0.1 --port 8788
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
