[Unit]
Description=小伴 v2 周日晚上给 Mia 发周报
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ethan
Group=ethan
WorkingDirectory=/home/ethan/Personal-OS
EnvironmentFile=/home/ethan/.config/ethan/ethan.env
Environment=PATH=/home/ethan/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/python3 -m ethan.jobs --data /home/ethan/data --name weekly -- /usr/bin/python3 -m ethan.report --data /home/ethan/data --weekly
