[Unit]
Description=小伴 v2 每周跑一遍题集评测（docs/design/digital-life-spec.md 第 6 节）
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ethan
Group=ethan
WorkingDirectory=/home/ethan/Personal-OS
EnvironmentFile=/home/ethan/.config/ethan/ethan.env
Environment=PATH=/home/ethan/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/python3 -m ethan.jobs --data /home/ethan/data --name evals -- /usr/bin/python3 -m ethan.evals --data /home/ethan/data
