[Unit]
Description=小伴 v2 收新邮件、分类、整理（ethan/imapmail.py；没录邮箱时什么都不做）
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ethan
Group=ethan
WorkingDirectory=/home/ethan/Personal-OS
EnvironmentFile=/home/ethan/.config/ethan/ethan.env
Environment=PATH=/home/ethan/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/python3 -m ethan.jobs --data /home/ethan/data --name mail -- /usr/bin/python3 -m ethan.imapmail --data /home/ethan/data
TimeoutStartSec=15min
