[Unit]
Description=小伴 v2 Codex 自动领活（从 agent 任务队列领一件，干完等 Claude 审查）
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ethan
Group=ethan
WorkingDirectory=/home/ethan/Personal-OS
Environment=PATH=/home/ethan/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/python3 -m ethan.codex_runner --data /home/ethan/data --repo /home/ethan/Personal-OS
# 机器只有 2 核 1.9G：一次只跑一件（oneshot 没跑完不会再开），内存超了宁可杀掉 Codex 也不拖垮 小伴
MemoryMax=900M
TimeoutStartSec=4h
