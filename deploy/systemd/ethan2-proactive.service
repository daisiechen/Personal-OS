[Unit]
Description=小伴 v2 主动消息检查
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ethan
Group=ethan
WorkingDirectory=/home/ethan/Personal-OS
EnvironmentFile=/home/ethan/.config/ethan/ethan.env
Environment=PATH=/home/ethan/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/python3 -m ethan.jobs --data /home/ethan/data --name proactive -- /usr/bin/python3 -m ethan.proactive --data /home/ethan/data
